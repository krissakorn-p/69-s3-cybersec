# REST

@adminEmail = {{$dotenv ADMIN_EMAIL}}
@adminPassword = {{$dotenv ADMIN_PASSWORD}}
@adminFirstname = {{$dotenv ADMIN_FIRSTNAME}}
@adminLastname = {{$dotenv ADMIN_LASTNAME}}
@adminResetToken = {{$dotenv ADMIN_RESET_TOKEN}}
@adminNewPassword = {{$dotenv ADMIN_NEW_PASSWORD}}
@rememberMe = {{$dotenv REMEMBER_ME}}
@adminToken = {{$dotenv ADMIN_TOKEN}}
@userUsername = {{$dotenv USER_USERNAME}}
@userEmail = {{$dotenv USER_EMAIL}}
@userPassword = {{$dotenv USER_PASSWORD}}
@userIdentifier = {{$dotenv USER_IDENTIFIER}}
@userResetCode = {{$dotenv USER_RESET_CODE}}
@userNewPassword = {{$dotenv USER_NEW_PASSWORD}}
@userToken = {{$dotenv USER_TOKEN}}
@studentName = {{$dotenv STUDENT_NAME}}
@studentMobile = {{$dotenv STUDENT_MOBILE}}
@studentCardId = {{$dotenv STUDENT_CARD_ID}}
@studentNameUpdate = {{$dotenv STUDENT_NAME_UPDATE}}
@studentMobileUpdate = {{$dotenv STUDENT_MOBILE_UPDATE}}
@studentCardIdUpdate = {{$dotenv STUDENT_CARD_ID_UPDATE}}
@teacherName = {{$dotenv TEACHER_NAME}}
@teacherMobile = {{$dotenv TEACHER_MOBILE}}
@teacherCardId = {{$dotenv TEACHER_CARD_ID}}
@teacherNameUpdate = {{$dotenv TEACHER_NAME_UPDATE}}
@teacherMobileUpdate = {{$dotenv TEACHER_MOBILE_UPDATE}}
@teacherCardIdUpdate = {{$dotenv TEACHER_CARD_ID_UPDATE}}
@subjectName = {{$dotenv SUBJECT_NAME}}
@subjectNameUpdate = {{$dotenv SUBJECT_NAME_UPDATE}}


## 1. Admin Section
### 1.1 Login
POST http://localhost:9093/admin/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "rememberMe": {{rememberMe}}
}

### 1.2 Signup
POST http://localhost:9093/admin/register
Content-Type: application/json

{
    "firstname": "{{adminFirstname}}",
    "lastname": "{{adminLastname}}",
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### 1.3 Forgot Password
POST http://localhost:9093/admin/forgot-password
Content-Type: application/json

{
    "email": "{{adminEmail}}"
}

### 1.3.1 Reset Password
POST http://localhost:9093/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "{{adminResetToken}}",
    "password": "{{adminNewPassword}}"
}

### 1.4 Profile
GET http://localhost:9093/admin/me
Authorization: Bearer {{adminToken}}


## 2. User Section
### 2.1 Login
POST http://localhost:9093/api/auth/local
Content-Type: application/json

{
    "identifier": "{{userIdentifier}}",
    "password": "{{userPassword}}"
}

### 2.2 Signup
POST http://localhost:9093/api/auth/local/register
Content-Type: application/json

{
    "username": "{{userUsername}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2.3 Forgot Password
POST http://localhost:9093/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{userEmail}}"
}

### 2.3.1 Reset Password
POST http://localhost:9093/api/auth/reset-password
Content-Type: application/json

{
    "code": "{{userResetCode}}",
    "password": "{{userNewPassword}}",
    "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 Profile
GET http://localhost:9093/api/users/me
Authorization: Bearer {{userToken}}

## 3. Content Section

## 3.1 student
###3.1.1 Create
POST http://localhost:9093/api/students
Content-Type: application/json

{
    "data": {
        "name": "{{studentName}}",
        "mobile": "{{studentMobile}}",
        "cardId": "{{studentCardId}}"
    }
}

###3.1.2 List All
GET http://localhost:9093/api/students

###3.1.3 List with ID
GET http://localhost:9093/api/students/2

###3.1.4 Update
PUT http://localhost:9093/api/students/2
Content-Type: application/json

{
    "data": {
        "name": "{{studentNameUpdate}}",
        "mobile": "{{studentMobileUpdate}}",
        "cardId": "{{studentCardIdUpdate}}"
    }
}

## 3.2 teacher
### 3.2.1 Create
POST http://localhost:9093/api/teachers
Content-Type: application/json

{
    "data": {
        "name": "{{teacherName}}",
        "mobile": "{{teacherMobile}}",
        "cardId": "{{teacherCardId}}"
    }
}   

### 3.2.2 List All
GET http://localhost:9093/api/teachers

### 3.2.3 List with ID
GET http://localhost:9093/api/teachers/2

### 3.2.4 Update
PUT http://localhost:9093/api/teachers/2
Content-Type: application/json

{
    "data": {
        "name": "{{teacherNameUpdate}}",
        "mobile": "{{teacherMobileUpdate}}",
        "cardId": "{{teacherCardIdUpdate}}"
    }
}


##3.3 Subject
###3.3.1 Create
POST http://localhost:9093/api/subjects
Content-Type: application/json  

{
    "data": {
        "name": "{{subjectName}}"
    }
}

###3.3.2 List All
GET http://localhost:9093/api/subjects

###3.3.3 List with ID
GET http://localhost:9093/api/subjects/1

###3.3.4 Update
PUT http://localhost:9093/api/subjects/1
Content-Type: application/json

{
    "data": {
        "name": "{{subjectNameUpdate}}"
    }
}
